{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "name": "bestvpsforme Highlighter", "version": "1.1.0", "date": "2026-10-03", "mirrors": "tokens.css" },
  "color": {
    "ink": { "950": "#0E1116", "900": "#161A21", "800": "#20252E", "700": "#2E3440", "600": "#474F5C", "500": "#636B78", "400": "#8A919C", "300": "#B4B9C1", "200": "#D9DCE1", "150": "#E4E6EA", "100": "#ECEEF1", "50": "#F5F6F8" },
    "paper": "#FFFFFF",
    "volt": { "50": "#F9FFE3", "100": "#F0FFB8", "200": "#E6FF85", "400": "#D4FF3A", "500": "#C2F01F", "600": "#A0CC10", "800": "#4F6407" },
    "vermilion": { "50": "#FFF2ED", "100": "#FFDFD2", "300": "#FF9670", "500": "#F4511E", "700": "#B53A12" },
    "signal": { "50": "#E8F8F0", "400": "#3DDC97", "700": "#0B7A4C" },
    "night": { "bg": "#0A0C10", "subtle": "#101318", "muted": "#171B22", "raised": "#151920", "border": "#232830", "fg": "#F3F5F7", "fgMuted": "#A9B0BB" }
  },
  "semantic": {
    "light": { "bg": "paper", "fg": "ink.950", "fgMuted": "ink.600", "border": "ink.150", "accent": "volt.400", "onAccent": "ink.950", "catch": "vermilion.500", "catchFg": "vermilion.700", "ok": "signal.700" },
    "dark": { "bg": "night.bg", "fg": "night.fg", "fgMuted": "night.fgMuted", "border": "night.border", "accent": "volt.400", "onAccent": "ink.950", "catch": "vermilion.500", "catchFg": "vermilion.300", "ok": "signal.400" }
  },
  "font": {
    "sans": { "family": "Mona Sans", "file": "brand/fonts/MonaSans.ttf", "axes": { "wdth": [75, 125], "wght": [200, 900] }, "license": "OFL-1.1" },
    "mono": { "family": "Geist Mono", "file": "brand/fonts/GeistMono.ttf", "axes": { "wght": [100, 900] }, "license": "OFL-1.1" }
  },
  "type": {
    "display2xl": { "font": "sans", "size": "clamp(30px, 3.8vw, 48px)", "lineHeight": 1.12, "weight": 720, "width": 100, "tracking": "-0.025em" },
    "displayXl": { "font": "sans", "size": "clamp(30px, 3.4vw, 40px)", "lineHeight": 1.15, "weight": 720, "width": 100, "tracking": "-0.025em" },
    "displayLg": { "font": "sans", "size": "clamp(28px, 3vw, 36px)", "lineHeight": 1.18, "weight": 700, "width": 100, "tracking": "-0.025em" },
    "displayMd": { "font": "sans", "size": "clamp(26px, 2.6vw, 32px)", "lineHeight": 1.2, "weight": 680, "width": 100, "tracking": "-0.025em" },
    "headingLg": { "font": "sans", "size": "32px", "lineHeight": 1.1, "weight": 700, "width": 100, "tracking": "-0.025em" },
    "headingMd": { "font": "sans", "size": "24px", "lineHeight": 1.2, "weight": 680, "width": 100, "tracking": "-0.02em" },
    "headingSm": { "font": "sans", "size": "19px", "lineHeight": 1.3, "weight": 650, "width": 100, "tracking": "-0.01em" },
    "bodyLg": { "font": "sans", "size": "19px", "lineHeight": 1.55, "weight": 420, "width": 100 },
    "body": { "font": "sans", "size": "16px", "lineHeight": 1.55, "weight": 420, "width": 100 },
    "bodySm": { "font": "sans", "size": "14px", "lineHeight": 1.5, "weight": 440, "width": 100 },
    "caption": { "font": "sans", "size": "14px", "lineHeight": 1.5, "weight": 480, "width": 100 },
    "eyebrow": { "font": "sans", "size": "14px", "lineHeight": 1.4, "weight": 600, "width": 100, "tracking": "0.01em", "case": "none" },
    "num2xl": { "font": "mono", "size": "40px", "lineHeight": 1.1, "weight": 600, "tracking": "-0.025em" },
    "numXl": { "font": "mono", "size": "32px", "lineHeight": 1.15, "weight": 600, "tracking": "-0.025em" },
    "numLg": { "font": "mono", "size": "32px", "lineHeight": 1, "weight": 600, "tracking": "-0.03em" },
    "numMd": { "font": "mono", "size": "22px", "lineHeight": 1.05, "weight": 600, "tracking": "-0.02em" },
    "num": { "font": "mono", "size": "15px", "lineHeight": 1.2, "weight": 520, "tracking": "-0.01em" }
  },
  "space": [0, 4, 6, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128, 160],
  "radius": { "xs": 4, "sm": 6, "md": 10, "lg": 16, "xl": 16, "2xl": 20, "full": 999, "markTile": "23.4%" },
  "layout": { "container": 1240, "containerWide": 1280, "prose": 720, "navHeight": 64, "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536 } },
  "shadow": {
    "1": "0 1px 0 rgb(14 17 22 / .04), 0 1px 2px rgb(14 17 22 / .06)",
    "2": "0 1px 0 rgb(14 17 22 / .04), 0 6px 16px -4px rgb(14 17 22 / .10)",
    "3": "0 2px 4px rgb(14 17 22 / .04), 0 18px 44px -14px rgb(14 17 22 / .22)",
    "pop": "0 28px 72px -18px rgb(14 17 22 / .34)",
    "sticker": "0 0 0 1.5px #0E1116, 6px 6px 0 0 #0E1116"
  },
  "motion": {
    "duration": { "instant": 90, "fast": 140, "base": 200, "slow": 320, "highlight": 520, "reveal": 640 },
    "easing": { "out": [0.22, 1, 0.36, 1], "inOut": [0.65, 0, 0.35, 1], "in": [0.5, 0, 0.75, 0] },
    "spring": {
      "snappy": { "damping": 20, "stiffness": 220, "mass": 1 },
      "smooth": { "damping": 26, "stiffness": 120, "mass": 1 },
      "pick": { "damping": 14, "stiffness": 170, "mass": 0.9 },
      "heavy": { "damping": 30, "stiffness": 90, "mass": 1.4 }
    },
    "video": { "fps": 30, "beatFrames": 15, "highlightFrames": 16, "holdFrames": 45 }
  }
}
