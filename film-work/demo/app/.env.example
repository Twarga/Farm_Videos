# Application
DATABASE_URL=file:./data/bestvpsforme.db
# Local-only opt-in. Omit for normal database-backed development and all production deployments.
BESTVPSFORME_PUBLIC_DATA_MODE=
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# Optional correction API verification. The built-in form has no Turnstile widget.
# Leave unset unless the submitting client supplies x-turnstile-token.
TURNSTILE_SECRET_KEY=
# R2 upload tooling uses these; the app creates local encrypted backups only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Local encrypted backups. Set the key privately; this directory is on the persistent volume.
BACKUP_KEY=
BACKUP_DIR=/app/data/backups

# Optional outbound email
RESEND_API_KEY=
EMAIL_FROM=
