 ],
 "sentences": [
  {
   "i": 0,
   "text": "This pirate is not missing an eye. He's carrying night vision.",
   "s": 0.0,
   "e": 3.3
  },
  {
   "i": 1,
   "text": "You see, pirates lived on a ship that was two worlds.",
   "s": 3.54,
   "e": 6.12
  },
  {
   "i": 2,
   "text": "Up top, blinding sunlight off the water. Below deck, pitch black.",
   "s": 6.5,
   "e": 10.24
  },
  {
   "i": 3,
   "text": "And in a fight, the action moved between them, constantly.",
   "s": 10.58,
   "e": 13.38
  },
  {
   "i": 4,
   "text": "Boarding crew up in the sun, gunpowder stored down in the dark.",
   "s": 13.74,
   "e": 16.92
  },
  {
   "i": 5,
   "text": "Now here's the problem. Your eyes take about twenty minutes to adjust to darkness.",
   "s": 17.3,
   "e": 21.54
  },
  {
   "i": 6,
   "text": "Twenty minutes. In a boarding fight, that's a lifetime.",
   "s": 22.04,
   "e": 24.48
  },
  {
   "i": 7,
   "text": "So pirates cheated.",
   "s": 24.96,
   "e": 25.9
  },
  {
   "i": 8,
   "text": "They kept one eye covered all day, so it stayed tuned for the dark.",
   "s": 26.24,
   "e": 29.68
  },
  {
   "i": 9,
   "text": "Below deck? Flip the patch up. Instant night vision.",
   "s": 30.06,
   "e": 32.84
  },
  {
   "i": 10,
   "text": "No waiting, no stumbling, no getting stabbed because you couldn't see.",
   "s": 33.14,
   "e": 36.86
  },
  {
   "i": 11,
   "text": "It worked so well that sailors could fight on two decks at once, blinking light and total dark.",
   "s": 37.1,
   "e": 42.28
  },
  {
   "i": 12,
   "text": "And it's not a legend. The US Navy tested the same trick centuries later.",
   "s": 42.48,
   "e": 46.9
  },
  {
   "i": 13,
   "text": "Night pilots were told to keep one eye closed in bright rooms before missions.",
   "s": 47.2,
   "e": 51.1
  },
  {
   "i": 14,
   "text": "One eye for daylight. One eye for the dark.",
   "s": 51.52,
   "e": 53.78
  },
  {
   "i": 15,
   "text": "The eye patch wasn't about what the pirate lost.",
   "s": 54.1,
   "e": 56.18
  },
  {
   "i": 16,
   "text": "It was about what he was ready for.",
   "s": 56.18,
   "e": 58.22
  }
 ]
}