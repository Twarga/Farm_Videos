[{"start": 0.0, "end": 2.96, "text": " They buried a man alive with a bell tied to his finger.", "words": [[0.0, 0.22, " They"], [0.22, 0.6, " buried"], [0.6, 0.76, " a"], [0.76, 0.88, " man"], [0.88, 1.32, " alive"], [1.32, 1.58, " with"], [1.58, 1.76, " a"], [1.76, 2.04, " bell"], [2.04, 2.32, " tied"], [2.32, 2.5, " to"], [2.5, 2.62, " his"], [2.62, 2.96, " finger."]]}, {"start": 3.16, "end": 7.3, "text": " You see, people were so scared of waking up in a coffin that graves came with a little", "words": [[3.16, 3.22, " You"], [3.22, 3.42, " see,"], [3.82, 3.82, " people"], [3.82, 4.02, " were"], [4.02, 4.34, " so"], [4.34, 4.72, " scared"], [4.72, 4.88, " of"], [4.88, 5.08, " waking"], [5.08, 5.32, " up"], [5.32, 5.44, " in"], [5.44, 5.58, " a"], [5.58, 5.84, " coffin"], [5.84, 6.2, " that"], [6.2, 6.52, " graves"], [6.52, 6.82, " came"], [6.82, 6.98, " with"], [6.98, 7.12, " a"], [7.12, 7.3, " little"]]}, {"start": 7.3, "end": 9.9, "text": " bell on top, tied by a string to the body's finger.", "words": [[7.3, 7.54, " bell"], [7.54, 7.74, " on"], [7.74, 8.02, " top,"], [8.2, 8.34, " tied"], [8.34, 8.54, " by"], [8.54, 8.66, " a"], [8.66, 8.94, " string"], [8.94, 9.14, " to"], [9.14, 9.26, " the"], [9.26, 9.6, " body's"], [9.6, 9.9, " finger."]]}, {"start": 10.08, "end": 14.28, "text": " Except when his bell starts ringing at 2 in the morning, the guy next door decides it's", "words": [[10.08, 10.38, " Except"], [10.38, 10.66, " when"], [10.66, 10.8, " his"], [10.8, 11.06, " bell"], [11.06, 11.34, " starts"], [11.34, 11.62, " ringing"], [11.62, 11.86, " at"], [11.86, 12.02, " 2"], [12.02, 12.14, " in"], [12.14, 12.28, " the"], [12.28, 12.54, " morning,"], [12.9, 12.94, " the"], [12.94, 13.1, " guy"], [13.1, 13.3, " next"], [13.3, 13.58, " door"], [13.58, 14.0, " decides"], [14.0, 14.28, " it's"]]}, {"start": 14.28, "end": 15.06, "text": " probably the wind.", "words": [[14.28, 14.6, " probably"], [14.6, 14.84, " the"], [14.84, 15.06, " wind."]]}, {"start": 15.36, "end": 19.28, "text": " Then it rings faster, and now the whole street is out on their porches, going,", "words": [[15.36, 15.52, " Then"], [15.52, 15.76, " it"], [15.76, 15.98, " rings"], [15.98, 16.5, " faster,"], [16.74, 16.86, " and"], [16.86, 17.06, " now"], [17.06, 17.24, " the"], [17.24, 17.56, " whole"], [17.56, 17.94, " street"], [17.94, 18.12, " is"], [18.12, 18.26, " out"], [18.26, 18.38, " on"], [18.38, 18.52, " their"], [18.52, 18.92, " porches,"], [19.04, 19.28, " going,"]]}, {"start": 19.58, "end": 20.12, "text": " you go check.", "words": [[19.58, 19.62, " you"], [19.62, 19.82, " go"], [19.82, 20.12, " check."]]}, {"start": 20.4, "end": 21.46, "text": " No, you go check.", "words": [[20.4, 20.62, " No,"], [20.8, 20.96, " you"], [20.96, 21.16, " go"], [21.16, 21.46, " check."]]}, {"start": 21.68, "end": 24.78, "text": " Somebody drags the doctor out of bed, and he goes, body's twitch.", "words": [[21.68, 21.94, " Somebody"], [21.94, 22.38, " drags"], [22.38, 22.54, " the"], [22.54, 22.78, " doctor"], [22.78, 23.0, " out"], [23.0, 23.14, " of"], [23.14, 23.36, " bed,"], [23.5, 23.6, " and"], [23.6, 23.7, " he"], [23.7, 23.94, " goes,"], [24.28, 24.58, " body's"], [24.58, 24.78, " twitch."]]}, {"start": 25.16, "end": 25.52, "text": " He's dead.", "words": [[25.16, 25.34, " He's"], [25.34, 25.52, " dead."]]}, {"start": 25.74, "end": 26.72, "text": " I signed the paper myself.", "words": [[25.74, 25.82, " I"], [25.82, 26.02, " signed"], [26.02, 26.14, " the"], [26.14, 26.34, " paper"], [26.34, 26.72, " myself."]]}, {"start": 27.08, "end": 28.56, "text": " But his wife isn't on her porch.", "words": [[27.08, 27.16, " But"], [27.16, 27.3, " his"], [27.3, 27.58, " wife"], [27.58, 28.02, " isn't"], [28.02, 28.16, " on"], [28.16, 28.3, " her"], [28.3, 28.56, " porch."]]}, {"start": 28.56, "end": 32.48, "text": " She's sitting in the dark with a shovel by the door, because she knows that ring.", "words": [[28.56, 29.16, " She's"], [29.16, 29.32, " sitting"], [29.32, 29.48, " in"], [29.48, 29.6, " the"], [29.6, 29.84, " dark"], [29.84, 30.02, " with"], [30.02, 30.16, " a"], [30.16, 30.42, " shovel"], [30.42, 30.66, " by"], [30.66, 30.8, " the"], [30.8, 31.06, " door,"], [31.18, 31.44, " because"], [31.44, 31.62, " she"], [31.62, 31.92, " knows"], [31.92, 32.2, " that"], [32.2, 32.48, " ring."]]}, {"start": 32.82, "end": 33.92, "text": " Three short, one long.", "words": [[32.82, 32.9, " Three"], [32.9, 33.22, " short,"], [33.48, 33.6, " one"], [33.6, 33.92, " long."]]}, {"start": 34.1, "end": 35.6, "text": " The exact signal they practiced.", "words": [[34.1, 34.22, " The"], [34.22, 34.62, " exact"], [34.62, 35.02, " signal"], [35.02, 35.22, " they"], [35.22, 35.6, " practiced."]]}, {"start": 35.92, "end": 36.66, "text": " Wait, practiced?", "words": [[35.92, 36.06, " Wait,"], [36.44, 36.66, " practiced?"]]}, {"start": 36.98, "end": 38.24, "text": " Well, he was never dead.", "words": [[36.98, 37.2, " Well,"], [37.52, 37.64, " he"], [37.64, 37.76, " was"], [37.76, 37.98, " never"], [37.98, 38.24, " dead."]]}, {"start": 38.42, "end": 41.1, "text": " He owed money to half the town, so he faked his death.", "words": [[38.42, 38.54, " He"], [38.54, 38.68, " owed"], [38.68, 38.94, " money"], [38.94, 39.12, " to"], [39.12, 39.32, " half"], [39.32, 39.52, " the"], [39.52, 39.8, " town,"], [39.96, 40.16, " so"], [40.16, 40.36, " he"], [40.36, 40.62, " faked"], [40.62, 40.82, " his"], [40.82, 41.1, " death."]]}, {"start": 41.26, "end": 44.08, "text": " And the second that bell rang, she was supposed to grab the shovel,", "words": [[41.26, 41.36, " And"], [41.36, 41.46, " the"], [41.46, 41.74, " second"], [41.74, 42.02, " that"], [42.02, 42.24, " bell"], [42.24, 42.5, " rang,"], [42.72, 42.84, " she"], [42.84, 42.96, " was"], [42.96, 43.2, " supposed"], [43.2, 43.4, " to"], [43.4, 43.62, " grab"], [43.62, 43.8, " the"], [43.8, 44.08, " shovel,"]]}, {"start": 44.3, "end": 45.82, "text": " dig him up, and skip town with him.", "words": [[44.3, 44.44, " dig"], [44.44, 44.56, " him"], [44.56, 44.72, " up,"], [44.82, 44.98, " and"], [44.98, 45.2, " skip"], [45.2, 45.48, " town"], [45.48, 45.68, " with"], [45.68, 45.82, " him."]]}, {"start": 45.98, "end": 50.04, "text": " Instead, she just sits there all night, listening to it ring fast, then slow,", "words": [[45.98, 46.34, " Instead,"], [46.52, 46.74, " she"], [46.74, 46.92, " just"], [46.92, 47.12, " sits"], [47.12, 47.36, " there"], [47.36, 47.66, " all"], [47.66, 47.98, " night,"], [48.14, 48.32, " listening"], [48.32, 48.56, " to"], [48.56, 48.66, " it"], [48.66, 48.86, " ring"], [48.86, 49.28, " fast,"], [49.6, 49.66, " then"], [49.66, 50.04, " slow,"]]}, {"start": 50.26, "end": 53.62, "text": " then once every few minutes, until sunrise, when it finally stops.", "words": [[50.26, 50.36, " then"], [50.36, 50.64, " once"], [50.64, 50.9, " every"], [50.9, 51.14, " few"], [51.14, 51.44, " minutes,"], [51.62, 51.88, " until"], [51.88, 52.34, " sunrise,"], [52.64, 52.76, " when"], [52.76, 52.86, " it"], [52.86, 53.22, " finally"], [53.22, 53.62, " stops."]]}, {"start": 53.96, "end": 57.68, "text": " You see, with him in the ground, every debt got buried right along with him,", "words": [[53.96, 54.06, " You"], [54.06, 54.26, " see,"], [54.42, 54.58, " with"], [54.58, 54.74, " him"], [54.74, 54.84, " in"], [54.84, 54.96, " the"], [54.96, 55.28, " ground,"], [55.58, 55.84, " every"], [55.84, 56.14, " debt"], [56.14, 56.36, " got"], [56.36, 56.72, " buried"], [56.72, 57.04, " right"], [57.04, 57.26, " along"], [57.26, 57.52, " with"], [57.52, 57.68, " him,"]]}, {"start": 57.68, "end": 59.2, "text": " and the house was all hers.", "words": [[57.68, 57.9, " and"], [57.9, 58.0, " the"], [58.0, 58.3, " house"], [58.3, 58.58, " was"], [58.58, 58.92, " all"], [58.92, 59.2, " hers."]]}]