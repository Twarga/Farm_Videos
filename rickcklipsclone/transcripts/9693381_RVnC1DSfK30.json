[{"start": 0.0, "end": 0.68, "text": " Could it be?", "words": [[0.0, 0.24, " Could"], [0.24, 0.4, " it"], [0.4, 0.68, " be?"]]}, {"start": 0.9, "end": 1.9, "text": " The Sword of Lies?", "words": [[0.9, 1.04, " The"], [1.04, 1.32, " Sword"], [1.32, 1.54, " of"], [1.54, 1.9, " Lies?"]]}, {"start": 2.26, "end": 4.16, "text": " I am the Sword of Truth.", "words": [[2.26, 2.6, " I"], [2.6, 2.84, " am"], [2.84, 3.06, " the"], [3.06, 3.36, " Sword"], [3.36, 3.66, " of"], [3.66, 4.16, " Truth."]]}, {"start": 4.58, "end": 5.46, "text": " Well, I'm convinced.", "words": [[4.58, 4.7, " Well,"], [4.78, 5.1, " I'm"], [5.1, 5.46, " convinced."]]}, {"start": 5.9, "end": 7.14, "text": " Now how do we get out of here?", "words": [[5.9, 6.0, " Now"], [6.0, 6.16, " how"], [6.16, 6.26, " do"], [6.26, 6.38, " we"], [6.38, 6.5, " get"], [6.5, 6.72, " out"], [6.72, 6.86, " of"], [6.86, 7.14, " here?"]]}, {"start": 7.46, "end": 7.86, "text": " Go left.", "words": [[7.46, 7.6, " Go"], [7.6, 7.86, " left."]]}, {"start": 8.28, "end": 8.92, "text": " Right it is.", "words": [[8.28, 8.48, " Right"], [8.48, 8.62, " it"], [8.62, 8.92, " is."]]}, {"start": 9.16, "end": 11.08, "text": " I don't think this is the right way, Sword of Lies.", "words": [[9.16, 9.3, " I"], [9.3, 9.48, " don't"], [9.48, 9.6, " think"], [9.6, 9.74, " this"], [9.74, 9.88, " is"], [9.88, 10.02, " the"], [10.02, 10.16, " right"], [10.16, 10.42, " way,"], [10.56, 10.66, " Sword"], [10.66, 10.84, " of"], [10.84, 11.08, " Lies."]]}]