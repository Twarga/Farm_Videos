[{"start": 0.0, "end": 3.76, "text": " If your ship got hit by a cannonball, you'd actually be one of the lucky ones.", "words": [[0.0, 0.16, " If"], [0.16, 0.38, " your"], [0.38, 0.58, " ship"], [0.58, 0.8, " got"], [0.8, 0.98, " hit"], [0.98, 1.16, " by"], [1.16, 1.42, " a"], [1.42, 1.9, " cannonball,"], [2.1, 2.28, " you'd"], [2.28, 2.54, " actually"], [2.54, 2.78, " be"], [2.78, 2.92, " one"], [2.92, 3.04, " of"], [3.04, 3.18, " the"], [3.18, 3.36, " lucky"], [3.36, 3.76, " ones."]]}, {"start": 3.92, "end": 8.58, "text": " In the 1700s, the Navy's round shot would smash through a pirate ship's wall and turn", "words": [[3.92, 4.02, " In"], [4.02, 4.14, " the"], [4.14, 5.06, " 1700s,"], [5.16, 5.28, " the"], [5.28, 5.7, " Navy's"], [5.7, 5.94, " round"], [5.94, 6.26, " shot"], [6.26, 6.46, " would"], [6.46, 6.88, " smash"], [6.88, 7.14, " through"], [7.14, 7.3, " a"], [7.3, 7.52, " pirate"], [7.52, 7.88, " ship's"], [7.88, 8.14, " wall"], [8.14, 8.38, " and"], [8.38, 8.58, " turn"]]}, {"start": 8.58, "end": 11.7, "text": " it into a storm of splinters that tore through half the crew.", "words": [[8.58, 8.7, " it"], [8.7, 8.88, " into"], [8.88, 9.0, " a"], [9.0, 9.36, " storm"], [9.36, 9.58, " of"], [9.58, 10.12, " splinters"], [10.12, 10.4, " that"], [10.4, 10.68, " tore"], [10.68, 10.96, " through"], [10.96, 11.2, " half"], [11.2, 11.42, " the"], [11.42, 11.7, " crew."]]}, {"start": 11.88, "end": 15.88, "text": " The pirates couldn't afford proper ammo, so they fired back with language, which is", "words": [[11.88, 11.98, " The"], [11.98, 12.26, " pirates"], [12.26, 12.58, " couldn't"], [12.58, 12.86, " afford"], [12.86, 13.2, " proper"], [13.2, 13.56, " ammo,"], [13.7, 13.86, " so"], [13.86, 14.04, " they"], [14.04, 14.26, " fired"], [14.26, 14.58, " back"], [14.58, 14.82, " with"], [14.82, 15.12, " language,"], [15.58, 15.76, " which"], [15.76, 15.88, " is"]]}, {"start": 15.88, "end": 17.82, "text": " a fancy word for literal garbage.", "words": [[15.88, 16.06, " a"], [16.06, 16.34, " fancy"], [16.34, 16.62, " word"], [16.62, 16.86, " for"], [16.86, 17.3, " literal"], [17.3, 17.82, " garbage."]]}, {"start": 18.06, "end": 20.82, "text": " But the Navy had a nastier idea called Hot Shot.", "words": [[18.06, 18.16, " But"], [18.16, 18.32, " the"], [18.32, 18.58, " Navy"], [18.58, 18.82, " had"], [18.82, 19.0, " a"], [19.0, 19.48, " nastier"], [19.48, 19.84, " idea"], [19.84, 20.2, " called"], [20.2, 20.56, " Hot"], [20.56, 20.82, " Shot."]]}, {"start": 21.04, "end": 25.04, "text": " They shoveled cannonballs into a furnace until they glowed red, carried them over with", "words": [[21.04, 21.14, " They"], [21.14, 21.64, " shoveled"], [21.64, 22.06, " cannonballs"], [22.06, 22.3, " into"], [22.3, 22.46, " a"], [22.46, 22.78, " furnace"], [22.78, 23.12, " until"], [23.12, 23.3, " they"], [23.3, 23.64, " glowed"], [23.64, 24.02, " red,"], [24.2, 24.4, " carried"], [24.4, 24.6, " them"], [24.6, 24.82, " over"], [24.82, 25.04, " with"]]}, {"start": 25.04, "end": 29.3, "text": " giant tongs, and dropped them in behind a soaking wet plug so the gunpowder wouldn't", "words": [[25.04, 25.44, " giant"], [25.44, 25.94, " tongs,"], [25.98, 26.16, " and"], [26.16, 26.42, " dropped"], [26.42, 26.62, " them"], [26.62, 26.78, " in"], [26.78, 27.04, " behind"], [27.04, 27.2, " a"], [27.2, 27.58, " soaking"], [27.58, 27.84, " wet"], [27.84, 28.14, " plug"], [28.14, 28.38, " so"], [28.38, 28.52, " the"], [28.52, 29.0, " gunpowder"], [29.0, 29.3, " wouldn't"]]}, {"start": 29.3, "end": 29.94, "text": " go off early.", "words": [[29.3, 29.42, " go"], [29.42, 29.64, " off"], [29.64, 29.94, " early."]]}, {"start": 30.26, "end": 34.54, "text": " The ball buried itself deep in the pirate ship's hull, and a few minutes later, the whole ship", "words": [[30.26, 30.26, " The"], [30.26, 30.46, " ball"], [30.46, 30.86, " buried"], [30.86, 31.2, " itself"], [31.2, 31.58, " deep"], [31.58, 31.76, " in"], [31.76, 31.88, " the"], [31.88, 32.12, " pirate"], [3