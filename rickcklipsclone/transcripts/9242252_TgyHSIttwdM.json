[{"start": 0.0, "end": 3.32, "text": " If you ever fake a number, there's a way to tell a human made it up.", "words": [[0.0, 0.18, " If"], [0.18, 0.34, " you"], [0.34, 0.66, " ever"], [0.66, 0.9, " fake"], [0.9, 1.08, " a"], [1.08, 1.3, " number,"], [1.52, 1.7, " there's"], [1.7, 1.78, " a"], [1.78, 1.9, " way"], [1.9, 2.04, " to"], [2.04, 2.28, " tell"], [2.28, 2.48, " a"], [2.48, 2.74, " human"], [2.74, 3.0, " made"], [3.0, 3.12, " it"], [3.12, 3.32, " up."]]}, {"start": 3.54, "end": 9.08, "text": " A man stole $2 million with fake checks, made every amount look totally random, and still", "words": [[3.54, 3.64, " A"], [3.64, 3.84, " man"], [3.84, 4.14, " stole"], [4.14, 4.56, " $2"], [4.56, 4.92, " million"], [4.92, 5.58, " with"], [5.58, 5.88, " fake"], [5.88, 6.28, " checks,"], [6.46, 6.66, " made"], [6.66, 7.06, " every"], [7.06, 7.32, " amount"], [7.32, 7.56, " look"], [7.56, 7.96, " totally"], [7.96, 8.38, " random,"], [8.58, 8.76, " and"], [8.76, 9.08, " still"]]}, {"start": 9.08, "end": 9.68, "text": " got caught.", "words": [[9.08, 9.32, " got"], [9.32, 9.68, " caught."]]}, {"start": 9.94, "end": 10.32, "text": " But how?", "words": [[9.94, 10.04, " But"], [10.04, 10.32, " how?"]]}, {"start": 10.68, "end": 12.8, "text": " Well, picture a building with 19 floors.", "words": [[10.68, 10.82, " Well,"], [11.24, 11.24, " picture"], [11.24, 11.48, " a"], [11.48, 11.7, " building"], [11.7, 11.96, " with"], [11.96, 12.42, " 19"], [12.42, 12.8, " floors."]]}, {"start": 13.24, "end": 15.1, "text": " Step into the elevator and look at the buttons.", "words": [[13.24, 13.38, " Step"], [13.38, 13.58, " into"], [13.58, 13.74, " the"], [13.74, 14.04, " elevator"], [14.04, 14.36, " and"], [14.36, 14.54, " look"], [14.54, 14.66, " at"], [14.66, 14.78, " the"], [14.78, 15.1, " buttons."]]}, {"start": 15.56, "end": 20.4, "text": " Floors 2 through 9 each start with a different number, but floor 1 and 10 all the way up", "words": [[15.56, 15.66, " Floors"], [15.66, 15.98, " 2"], [15.98, 16.18, " through"], [16.18, 16.5, " 9"], [16.5, 16.86, " each"], [16.86, 17.14, " start"], [17.14, 17.3, " with"], [17.3, 17.46, " a"], [17.46, 17.74, " different"], [17.74, 18.04, " number,"], [18.22, 18.38, " but"], [18.38, 18.6, " floor"], [18.6, 19.0, " 1"], [19.0, 19.38, " and"], [19.38, 19.7, " 10"], [19.7, 20.04, " all"], [20.04, 20.16, " the"], [20.16, 20.28, " way"], [20.28, 20.4, " up"]]}, {"start": 20.4, "end": 22.44, "text": " to 19 all start with a 1.", "words": [[20.4, 20.54, " to"], [20.54, 21.0, " 19"], [21.0, 21.48, " all"], [21.48, 21.8, " start"], [21.8, 22.02, " with"], [22.02, 22.16, " a"], [22.16, 22.44, " 1."]]}, {"start": 22.7, "end": 24.08, "text": " That's more than half the buttons!", "words": [[22.7, 22.94, " That's"], [22.94, 23.08, " more"], [23.08, 23.26, " than"], [23.26, 23.54, " half"], [23.54, 23.76, " the"], [23.76, 24.08, " buttons!"]]}, {"start": 24.44, "end": 28.68, "text": " Real numbers work like that elevator, so 1s show up way more than anything else.", "words": [[24.44, 24.7, " Real"], [24.7, 24.98, " numbers"], [24.98, 25.3, " work"], [25.3, 25.5, " like"], [25.5, 25.68, " that"], [25.68, 26.04, " elevator,"], [26.26, 26.54, " so"], [26.54, 26.98, " 1s"], [26.98, 27.12, " show"], [27.12, 27.32, " up"], [27.32, 27.58, " way"], [27.58, 27.84, " more"], [27.84, 28.02, " than"], [28.02, 28.34, " anything"], [28.34, 28.68, " else."]]}, {"start": 28.68, "end": 31.58, "text": " On top of that, real randomness is streaky.", "words": [[28.68, 29.06, " On"], [29.06, 29.28, " top"], [29.28, 29.46, " of"], [29.46, 29.62, " that,"], [29.98, 30.14, " real"], [30.14, 30.7, " randomness"], [30.7, 30.9, " is"], [30.9, 31.58, " streaky."]]}, {"start": 31.76, "end": 35.14, "text": " Flip a coin 100 times, and you'll usually get 6 heads in a row.", "words": [[31.76, 31.88, " Flip"], [31.88, 32.02, " a"], [32.02, 32.22, " coin"], [32.22, 32.68, " 100"], [32.68, 33.12, " times,"], [33.34, 33.44, " and"], [33.44, 33.64, " you'll"], [33.64, 33.94, " usually"], [33.94, 34.16, " get"], [34.16, 34.42, " 6"], [34.42, 34.64, " heads"], [34.64, 34.82, " in"], [34.82, 34.92, " a"], [34.92, 35.14, " row."]]}, {"start": 35.32, "end": 40.22, "text": " His checks mostly began with a 7, 8, or 9, and he avoided doubles to make them look random.", "words": [[35.32, 35.46, " His"], [35.46, 35.72, " checks"], [35.72, 36.16, " mostly"], [36.16, 36.5, " began"], [36.5, 36.68, " with"], [36.68, 36.82, " a"], [36.82, 37.12, " 7,"], [37.3, 37.52, " 8,"], [37.68, 37.76, " or"], [37.76, 38.04, " 9,"], [38.18, 38.36, " and"], [38.36, 38.48, " he"], [38.48, 38.8, " avoided"], [38.8, 39.18, " doubles"], [39.18, 39.46, " to"], [39.46, 39.56, " make"], [39.56, 39.72, " them"], [39.72, 39.86, " look"], [39.86, 40.22, " random."]]}, {"start": 40.4, "end": 42.44, "text": " But truly random numbers are the opposite.", "words": [[40.4, 40.54, " But"], [40.54, 40.9, " truly"], [40.9, 41.34, " random"], [41.34, 41.72, " numbers"], [41.72, 41.92, " are"], [41.92, 42.08, " the"], [42.08, 42.44, " opposite."]]}, {"start": 42.84, "end": 47.04, "text": " So no matter how random you try to make yours, there's almost always a way to tell.", "words": [[42.84, 43.08, " So"], [43.08, 43.28, " no"], [43.28, 43.44, " matter"], [43.44, 43.78, " how"], [43.78, 44.04, " random"], [44.04, 44.24, " you"], [44.24, 44.44, " try"], [44.44, 44.54, " to"], [44.54, 44.7, " make"], [44.7, 44.96, " yours,"], [45.32, 45.58, " there's"], [45.58, 45.88, " almost"], [45.88, 46.4, " always"], [46.4, 46.62, " a"], [46.62, 46.72, " way"], [46.72, 46.86, " to"], [46.86, 47.04, " tell."]]}]