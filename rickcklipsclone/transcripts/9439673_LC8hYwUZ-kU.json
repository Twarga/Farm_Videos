[{"start": 0.0, "end": 3.36, "text": " The fastest gun in the West had one rule. Never draw first.", "words": [[0.0, 0.16, " The"], [0.16, 0.5, " fastest"], [0.5, 0.8, " gun"], [0.8, 0.92, " in"], [0.92, 1.02, " the"], [1.02, 1.22, " West"], [1.22, 1.5, " had"], [1.5, 1.78, " one"], [1.78, 2.16, " rule."], [2.46, 2.64, " Never"], [2.64, 2.96, " draw"], [2.96, 3.36, " first."]]}, {"start": 3.66, "end": 8.12, "text": " Imagine you're standing in the street at noon, staring down a guy everyone calls slow Eddie.", "words": [[3.66, 3.88, " Imagine"], [3.88, 4.26, " you're"], [4.26, 4.48, " standing"], [4.48, 4.7, " in"], [4.7, 4.78, " the"], [4.78, 5.06, " street"], [5.06, 5.26, " at"], [5.26, 5.5, " noon,"], [5.86, 6.02, " staring"], [6.02, 6.3, " down"], [6.3, 6.42, " a"], [6.42, 6.58, " guy"], [6.58, 7.0, " everyone"], [7.0, 7.44, " calls"], [7.44, 7.88, " slow"], [7.88, 8.12, " Eddie."]]}, {"start": 8.34, "end": 9.42, "text": " His hands are at his sides.", "words": [[8.34, 8.46, " His"], [8.46, 8.72, " hands"], [8.72, 8.86, " are"], [8.86, 8.98, " at"], [8.98, 9.14, " his"], [9.14, 9.42, " sides."]]}, {"start": 9.7, "end": 12.58, "text": " He hasn't even looked at his gun, and he just nods at you and says,", "words": [[9.7, 9.8, " He"], [9.8, 10.02, " hasn't"], [10.02, 10.18, " even"], [10.18, 10.44, " looked"], [10.44, 10.62, " at"], [10.62, 10.78, " his"], [10.78, 11.06, " gun,"], [11.2, 11.3, " and"], [11.3, 11.38, " he"], [11.38, 11.54, " just"], [11.54, 11.84, " nods"], [11.84, 12.02, " at"], [12.02, 12.18, " you"], [12.18, 12.34, " and"], [12.34, 12.58, " says,"]]}, {"start": 13.06, "end": 13.34, "text": " After you.", "words": [[13.06, 13.06, " After"], [13.06, 13.34, " you."]]}, {"start": 13.62, "end": 16.62, "text": " So you grab for your gun faster than you've ever moved in your life.", "words": [[13.62, 13.68, " So"], [13.68, 13.84, " you"], [13.84, 14.06, " grab"], [14.06, 14.26, " for"], [14.26, 14.4, " your"], [14.4, 14.6, " gun"], [14.6, 14.92, " faster"], [14.92, 15.24, " than"], [15.24, 15.48, " you've"], [15.48, 15.78, " ever"], [15.78, 16.02, " moved"], [16.02, 16.18, " in"], [16.18, 16.32, " your"], [16.32, 16.62, " life."]]}, {"start": 16.8, "end": 19.42, "text": " Yet, you're face down in the dirt before it clears the holster.", "words": [[16.8, 17.0, " Yet,"], [17.12, 17.34, " you're"], [17.34, 17.52, " face"], [17.52, 17.8, " down"], [17.8, 17.94, " in"], [17.94, 18.06, " the"], [18.06, 18.28, " dirt"], [18.28, 18.6, " before"], [18.6, 18.76, " it"], [18.76, 18.96, " clears"], [18.96, 19.16, " the"], [19.16, 19.42, " holster."]]}, {"start": 19.72, "end": 20.52, "text": " How is that possible?", "words": [[19.72, 19.86, " How"], [19.86, 19.98, " is"], [19.98, 20.14, " that"], [20.14, 20.52, " possible?"]]}, {"start": 20.86, "end": 21.92, "text": " Eddie isn't even fast.", "words": [[20.86, 21.02, " Eddie"], [21.02, 21.26, " isn't"], [21.26, 21.48, " even"], [21.48, 21.92, " fast."]]}, {"start": 22.24, "end": 25.18, "text": " He'd lose a race to the saloon against a guy carrying two beers.", "words": [[22.24, 22.42, " He'd"], [22.42, 22.5, " lose"], [22.5, 22.68, " a"], [22.68, 22.86, " race"], [22.86, 23.04, " to"], [23.04, 23.18, " the"], [23.18, 23.52, " saloon"], [23.52, 23.74, " against"], [23.74, 23.94, " a"], [23.94, 24.12, " guy"], [24.12, 24.5, " carrying"], [24.5, 24.78, " two"], [24.78, 25.18, " beers."]]}, {"start": 25.46, "end": 28.06, "text": " But men ride in from three states away to duel him,", "words": [[25.46, 25.56, " But"], [25.56, 25.82, " men"], [25.82, 26.08, " ride"], [26.08, 26.28, " in"], [26.28, 26.44, " from"], [26.44, 26.86, " three"], [26.86, 27.12, " states"], [27.12, 27.46, " away"], [27.46, 27.62, " to"], [27.62, 27.84, " duel"], [27.84, 28.06, " him,"]]}, {"start": 28.06, "end": 30.82, "text": " and every one of them goes down the exact same way.", "words": [[28.06, 28.28, " and"], [28.28, 28.7, " every"], [28.7, 28.92, " one"], [28.92, 29.04, " of"], [29.04, 29.18, " them"], [29.18, 29.36, " goes"], [29.36, 29.62, " down"], [29.62, 29.76, " the"], [29.76, 30.16, " exact"], [30.16, 30.52, " same"], [30.52, 30.82, " way."]]}, {"start": 31.0, "end": 34.72, "text": " The only weird thing anyone ever notices is that Eddie never looks at your face.", "words": [[31.0, 31.06, " The"], [31.06, 31.26, " only"], [31.26, 31.62, " weird"], [31.62, 31.88, " thing"], [31.88, 32.14, " anyone"], [32.14, 32.4, " ever"], [32.4, 32.78, " notices"], [32.78, 33.2, " is"], [33.2, 33.4, " that"], [33.4, 33.58, " Eddie"], [33.58, 33.92, " never"], [33.92, 34.12, " looks"], [34.12, 34.28, " at"], [34.28, 34.46, " your"], [34.46, 34.72, " face."]]}, {"start": 34.98, "end": 36.22, "text": " He just stares at your hand.", "words": [[34.98, 35.08, " He"], [35.08, 35.2, " just"], [35.2, 35.54, " stares"], [35.54, 35.74, " at"], [35.74, 35.88, " your"], [35.88, 36.22, " hand."]]}, {"start": 36.46, "end": 39.12, "text": " You see, think about the last time your phone slid off a table.", "words": [[36.46, 36.46, " You"], [36.46, 36.64, " see,"], [36.82, 36.98, " think"], [36.98, 37.16, " about"], [37.16, 37.32, " the"], [37.32, 37.54, " last"], [37.54, 37.84, " time"], [37.84, 37.98, " your"], [37.98, 38.26, " phone"], [38.26, 38.56, " slid"], [38.56, 38.74, " off"], [38.74, 38.88, " a"], [38.88, 39.12, " table."]]}, {"start": 39.3, "end": 41.58, "text": " You caught it before you even realized it was falling,", "words": [[39.3, 39.42, " You"], [39.42, 39.66, " caught"], [39.66, 39.84, " it"], [39.84, 40.1, " before"], [40.1, 40.24, " you"], [40.24, 40.46, " even"], [40.46, 40.92, " realized"], [40.92, 41.12, " it"], [41.12, 41.2, " was"], [41.2, 41.58, " falling,"]]}, {"start": 41.62, "end": 43.36, "text": " because you never decided to catch it.", "words": [[41.62, 41.86, " because"], [41.86, 42.04, " you"], [42.04, 42.28, " never"], [42.28, 42.74, " decided"], [42.74, 43.0, " to"], [43.0, 43.16, " catch"], [43.16, 43.36, " it."]]}, {"start": 43.44, "end": 44.4, "text": " Your body just did.", "words": [[43.44, 43.54, " Your"], [43.54, 43.82, " body"], [43.82, 44.06, " just"], [44.06, 44.4, " did."]]}, {"start": 44.6, "end": 48.24, "text": " But when you went for your gun, you had to decide the exact moment to draw,", "words": [[44.6, 44.68, " But"], [44.68, 44.84, " when"], [44.84, 44.96, " you"], [44.96, 45.1, " went"], [45.1, 45.26, " for"], [45.26, 45.42, " your"], [45.42, 45.68, " gun,"], [45.84, 46.0, " you"], [46.0, 46.26, " had"], [46.26, 46.44, " to"], [46.44, 46.76, " decide"], [46.76, 46.98, " the"], [46.98, 47.4, " exact"], [47.4, 47.68, " moment"], [47.68, 47.94, " to"], [47.94, 48.24, " draw,"]]}, {"start": 48.34, "end": 50.7, "text": " and that tiny decision slowed your hand down.", "words": [[48.34, 48.5, " and"], [48.5, 48.66, " that"], [48.66, 49.04, " tiny"], [49.04, 49.52, " decision"], [49.52, 49.94, " slowed"], [49.94, 50.16, " your"], [50.16, 50.42, " hand"], [50.42, 50.7, " down."]]}, {"start": 50.88, "end": 52.32, "text": " Eddie never decides anything.", "words": [[50.88, 51.06, " Eddie"], [51.06, 51.44, " never"], [51.44, 51.92, " decides"], [51.92, 52.32, " anything."]]}, {"start": 52.62, "end": 55.9, "text": " He just waits for your hand to twitch and lets his body react on its own.", "words": [[52.62, 52.72, " He"], [52.72, 52.84, " just"], [52.84, 53.1, " waits"], [53.1, 53.3, " for"], [53.3, 53.42, " your"], [53.42, 53.62, " hand"], [53.62, 53.78, " to"], [53.78, 54.06, " twitch"], [54.06, 54.36, " and"], [54.36, 54.5, " lets"], [54.5, 54.68, " his"], [54.68, 54.98, " body"], [54.98, 55.32, " react"], [55.32, 55.52, " on"], [55.52, 55.64, " its"], [55.64, 55.9, " own."]]}]