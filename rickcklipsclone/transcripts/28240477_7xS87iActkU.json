[{"start": 0.0, "end": 3.14, "text": " He saw gaps into a railroad every 39 feet.", "words": [[0.0, 0.18, " He"], [0.18, 0.42, " saw"], [0.42, 0.86, " gaps"], [0.86, 1.1, " into"], [1.1, 1.3, " a"], [1.3, 1.72, " railroad"], [1.72, 2.14, " every"], [2.14, 2.76, " 39"], [2.76, 3.14, " feet."]]}, {"start": 3.46, "end": 5.86, "text": " You see, two companies are racing to build a railroad", "words": [[3.46, 3.46, " You"], [3.46, 3.62, " see,"], [3.82, 3.92, " two"], [3.92, 4.28, " companies"], [4.28, 4.56, " are"], [4.56, 4.94, " racing"], [4.94, 5.2, " to"], [5.2, 5.34, " build"], [5.34, 5.48, " a"], [5.48, 5.86, " railroad"]]}, {"start": 5.86, "end": 8.4, "text": " along a canyon so deep you can't see the bottom.", "words": [[5.86, 6.14, " along"], [6.14, 6.3, " a"], [6.3, 6.6, " canyon"], [6.6, 7.04, " so"], [7.04, 7.36, " deep"], [7.36, 7.56, " you"], [7.56, 7.86, " can't"], [7.86, 8.0, " see"], [8.0, 8.14, " the"], [8.14, 8.4, " bottom."]]}, {"start": 8.62, "end": 11.36, "text": " And whoever finishes first gets the whole country's business.", "words": [[8.62, 8.68, " And"], [8.68, 8.9, " whoever"], [8.9, 9.3, " finishes"], [9.3, 9.68, " first"], [9.68, 10.02, " gets"], [10.02, 10.24, " the"], [10.24, 10.56, " whole"], [10.56, 11.1, " country's"], [11.1, 11.36, " business."]]}, {"start": 11.68, "end": 13.24, "text": " He's the youngest engineer on the job.", "words": [[11.68, 11.82, " He's"], [11.82, 11.96, " the"], [11.96, 12.26, " youngest"], [12.26, 12.62, " engineer"], [12.62, 12.86, " on"], [12.86, 12.98, " the"], [12.98, 13.24, " job."]]}, {"start": 13.44, "end": 15.3, "text": " And when his boss sees a finger-wide gap", "words": [[13.44, 13.5, " And"], [13.5, 13.6, " when"], [13.6, 13.74, " his"], [13.74, 13.98, " boss"], [13.98, 14.2, " sees"], [14.2, 14.34, " a"], [14.34, 14.66, " finger"], [14.66, 14.96, "-wide"], [14.96, 15.3, " gap"]]}, {"start": 15.3, "end": 17.9, "text": " between every single rail, his face goes purple.", "words": [[15.3, 15.58, " between"], [15.58, 16.04, " every"], [16.04, 16.3, " single"], [16.3, 16.62, " rail,"], [16.78, 16.9, " his"], [16.9, 17.2, " face"], [17.2, 17.46, " goes"], [17.46, 17.9, " purple."]]}, {"start": 18.18, "end": 19.38, "text": " You're wrecking my railroad!", "words": [[18.18, 18.38, " You're"], [18.38, 18.7, " wrecking"], [18.7, 18.86, " my"], [18.86, 19.38, " railroad!"]]}, {"start": 19.62, "end": 21.46, "text": " But he won't close a single one.", "words": [[19.62, 19.74, " But"], [19.74, 19.92, " he"], [19.92, 20.28, " won't"], [20.28, 20.52, " close"], [20.52, 20.76, " a"], [20.76, 21.14, " single"], [21.14, 21.46, " one."]]}, {"start": 21.64, "end": 23.78, "text": " The other company lays their rails end to end,", "words": [[21.64, 21.76, " The"], [21.76, 21.96, " other"], [21.96, 22.28, " company"], [22.28, 22.56, " lays"], [22.56, 22.78, " their"], [22.78, 23.04, " rails"], [23.04, 23.36, " end"], [23.36, 23.52, " to"], [23.52, 23.78, " end,"]]}, {"start": 23.98, "end": 25.82, "text": " perfectly smooth, and finishes first.", "words": [[23.98, 24.32, " perfectly"], [24.32, 24.74, " smooth,"], [24.9, 25.06, " and"], [25.06, 25.38, " finishes"], [25.38, 25.82, " first."]]}, {"start": 26.06, "end": 28.54, "text": " Their trains glide across the canyon without a sound,", "words": [[26.06, 26.18, " Their"], [26.18, 26.5, " trains"], [26.5, 26.88, " glide"], [26.88, 27.18, " across"], [27.18, 27.4, " the"], [27.4, 27.68, " canyon"], [27.68, 28.04, " without"], [28.04, 28.24, " a"], [28.24, 28.54, " sound,"]]}, {"start": 28.54, "end": 31.02, "text": " while his go clickety-clack over every gap.", "words": [[28.54, 28.8, " while"], [28.8, 29.04, " his"], [29.04, 29.36, " go"], [29.36, 29.8, " clickety"], [29.8, 30.08, "-clack"], [30.08, 30.28, " over"], [30.28, 30.72, " every"], [30.72, 31.02, " gap."]]}, {"start": 31.28, "end": 33.62, "text": " The newspapers start calling it the clickety-clack line,", "words": [[31.28, 31.3, " The"], [31.3, 31.62, " newspapers"], [31.62, 32.0, " start"], [32.0, 32.3, " calling"], [32.3, 32.48, " it"], [32.48, 32.64, " the"], [32.64, 33.04, " clickety"], [33.04, 33.34, "-clack"], [33.34, 33.62, " line,"]]}, {"start": 33.76, "end": 35.72, "text": " and everyone switches to the quiet trains.", "words": [[33.76, 33.86, " and"], [33.86, 34.32, " everyone"], [34.32, 34.66, " switches"], [34.66, 34.94, " to"], [34.94, 35.06, " the"], [35.06, 35.32, " quiet"], [35.32, 35.72, " trains."]]}, {"start": 36.0, "end": 38.56, "text": " Then summer comes, and something weird happens.", "words": [[36.0, 36.16, " Then"], [36.16, 36.6, " summer"], [36.6, 36.96, " comes,"], [37.18, 37.36, " and"], [37.36, 37.74, " something"], [37.74, 38.06, " weird"], [38.06, 38.56, " happens."]]}, {"start": 38.74, "end": 40.02, "text": " His gaps start shrinking.", "words": [[38.74, 38.88, " His"], [38.88, 39.24, " gaps"], [39.24, 39.54, " start"], [39.54, 40.02, " shrinking."]]}, {"start": 40.26, "end": 41.9, "text": " In May, you can fit a coin in them.", "words": [[40.26, 40.38, " In"], [40.38, 40.64, " May,"], [40.86, 40.94, " you"], [40.94, 41.06, " can"], [41.06, 41.22, " fit"], [41.22, 41.34, " a"], [41.34, 41.56, " coin"], [41.56, 41.72, " in"], [41.72, 41.9, " them."]]}, {"start": 42.0, "end": 43.84, "text": " By July, barely a sheet of paper,", "words": [[42.0, 42.12, " By"], [42.12, 42.42, " July,"], [42.7, 42.88, " barely"], [42.88, 43.16, " a"], [43.16, 43.36, " sheet"], [43.36, 43.5, " of"], [43.5, 43.84, " paper,"]]}, {"start": 44.0, "end": 45.32, "text": " and his boss is thrilled.", "words": [[44.0, 44.12, " and"], [44.12, 44.24, " his"], [44.24, 44.58, " boss"], [44.58, 44.86, " is"], [44.86, 45.32, " thrilled."]]}, {"start": 45.64, "end": 45.88, "text": " See?", "words": [[45.64, 45.88, " See?"]]}, {"start": 46.16, "end": 47.68, "text": " Even your gaps know you were wrong.", "words": [[46.16, 46.34, " Even"], [46.34, 46.54, " your"], [46.54, 46.86, " gaps"], [46.86, 47.08, " know"], [47.08, 47.24, " you"], [47.24, 47.4, " were"], [47.4, 47.68, " wrong."]]}, {"start": 47.9, "end": 49.48, "text": " Meanwhile, on the perfect railroad,", "words": [[47.9, 48.18, " Meanwhile,"], [48.48, 48.58, " on"], [48.58, 48.74, " the"], [48.74, 49.06, " perfect"], [49.06, 49.48, " railroad,"]]}, {"start": 49.72, "end": 52.04, "text": " the rails have started groaning in the afternoon sun,", "words": [[49.72, 49.8, " the"], [49.8, 50.0, " rails"], [50.0, 50.2, " have"], [50.2, 50.5, " started"], [50.5, 51.0, " groaning"], [51.0, 51.18, " in"], [51.18, 51.28, " the"], [51.28, 51.64, " afternoon"], [51.64, 52.04, " sun,"]]}, {"start": 52.2, "end": 54.16, "text": " pushing against each other like they want to get out.", "words": [[52.2, 52.44, " pushing"], [52.44, 52.78, " against"], [52.78, 53.02, " each"], [53.02, 53.22, " other"], [53.22, 53.38, " like"], [53.38, 53.54, " they"], [53.54, 53.7, " want"], [53.7, 53.8, " to"], [53.8, 53.92, " get"], [53.92, 54.16, " out."]]}, {"start": 54.34, "end": 56.3, "text": " On the hottest day anyone can remember,", "words": [[54.34, 54.44, " On"], [54.44, 54.62, " the"], [54.62, 54.92, " hottest"], [54.92, 55.24, " day"], [55.24, 55.6, " anyone"], [55.6, 55.9, " can"], [55.9, 56.3, " remember,"]]}, {"start": 56.42, "end": 57.82, "text": " his gaps finally close.", "words": [[56.42, 56.6, " his"], [56.6, 56.88, " gaps"], [56.88, 57.42, " finally"], [57.42, 57.82, " close."]]}, {"start": 57.82, "end": 59.16, "text": " Rail touching rail.", "words": [[57.82, 58.34, " Rail"], [58.34, 58.82, " touching"], [58.82, 59.16, " rail."]]}, {"start": 59.4, "end": 60.52, "text": " And halfway across the canyon,", "words": [[59.4, 59.44, " And"], [59.44, 59.7, " halfway"], [59.7, 60.06, " across"], [60.06, 60.24, " the"], [60.24, 60.52, " canyon,"]]}, {"start": 60.72, "end": 63.12, "text": " the perfect railroad kicks sideways like a snake,", "words": [[60.72, 60.8, " the"], [60.8, 61.14, " perfect"], [61.14, 61.58, " railroad"], [61.58, 61.92, " kicks"], [61.92, 62.38, " sideways"], [62.38, 62.66, " like"], [62.66, 62.8, " a"], [62.8, 63.12, " snake,"]]}, {"start": 63.28, "end": 64.9, "text": " right as a train rolls onto it.", "words": [[63.28, 63.52, " right"], [63.52, 63.72, " as"], [63.72, 63.84, " a"], [63.84, 64.14, " train"], [64.14, 64.4, " rolls"], [64.4, 64.64, " onto"], [64.64, 64.9, " it."]]}]