[{"start": 0.0, "end": 4.18, "text": " It's impossible to get fired in Japan, but companies found something way worse.", "words": [[0.0, 0.24, " It's"], [0.24, 0.7, " impossible"], [0.7, 1.04, " to"], [1.04, 1.16, " get"], [1.16, 1.44, " fired"], [1.44, 1.68, " in"], [1.68, 2.0, " Japan,"], [2.24, 2.38, " but"], [2.38, 2.68, " companies"], [2.68, 3.0, " found"], [3.0, 3.42, " something"], [3.42, 3.8, " way"], [3.8, 4.18, " worse."]]}, {"start": 4.5, "end": 9.1, "text": " Imagine your boss walks you past your desk to a tiny room with no computer and no work.", "words": [[4.5, 4.68, " Imagine"], [4.68, 4.96, " your"], [4.96, 5.22, " boss"], [5.22, 5.52, " walks"], [5.52, 5.72, " you"], [5.72, 5.9, " past"], [5.9, 6.12, " your"], [6.12, 6.36, " desk"], [6.36, 6.6, " to"], [6.6, 6.74, " a"], [6.74, 7.02, " tiny"], [7.02, 7.36, " room"], [7.36, 7.58, " with"], [7.58, 7.86, " no"], [7.86, 8.22, " computer"], [8.22, 8.56, " and"], [8.56, 8.78, " no"], [8.78, 9.1, " work."]]}, {"start": 9.26, "end": 13.22, "text": " Just a ticking clock and a guy with his feet up, scrolling on his phone like he's on vacation.", "words": [[9.26, 9.4, " Just"], [9.4, 9.56, " a"], [9.56, 9.82, " ticking"], [9.82, 10.2, " clock"], [10.2, 10.4, " and"], [10.4, 10.52, " a"], [10.52, 10.72, " guy"], [10.72, 10.86, " with"], [10.86, 10.98, " his"], [10.98, 11.22, " feet"], [11.22, 11.42, " up,"], [11.58, 11.8, " scrolling"], [11.8, 12.02, " on"], [12.02, 12.16, " his"], [12.16, 12.4, " phone"], [12.4, 12.58, " like"], [12.58, 12.72, " he's"], [12.72, 12.84, " on"], [12.84, 13.22, " vacation."]]}, {"start": 13.62, "end": 15.74, "text": " Your new job, your boss says, is nothing.", "words": [[13.62, 13.72, " Your"], [13.72, 13.9, " new"], [13.9, 14.28, " job,"], [14.4, 14.54, " your"], [14.54, 14.74, " boss"], [14.74, 15.02, " says,"], [15.24, 15.36, " is"], [15.36, 15.74, " nothing."]]}, {"start": 16.04, "end": 19.64, "text": " Just sit here until six, and you're thinking, wait, I'm getting paid for this?", "words": [[16.04, 16.18, " Just"], [16.18, 16.36, " sit"], [16.36, 16.54, " here"], [16.54, 16.74, " until"], [16.74, 17.04, " six,"], [17.34, 17.44, " and"], [17.44, 17.56, " you're"], [17.56, 17.8, " thinking,"], [18.2, 18.34, " wait,"], [18.58, 18.74, " I'm"], [18.74, 18.92, " getting"], [18.92, 19.22, " paid"], [19.22, 19.42, " for"], [19.42, 19.64, " this?"]]}, {"start": 19.88, "end": 21.3, "text": " At first, it's paradise.", "words": [[19.88, 20.02, " At"], [20.02, 20.36, " first,"], [20.64, 20.82, " it's"], [20.82, 21.3, " paradise."]]}, {"start": 21.68, "end": 24.22, "text": " Then, your co-workers start staring when you walk past.", "words": [[21.68, 21.92, " Then,"], [22.14, 22.26, " your"], [22.26, 22.44, " co"], [22.44, 22.64, "-workers"], [22.64, 22.98, " start"], [22.98, 23.42, " staring"], [23.42, 23.6, " when"], [23.6, 23.74, " you"], [23.74, 23.9, " walk"], [23.9, 24.22, " past."]]}, {"start": 24.52, "end": 28.32, "text": " The emails stop, and your old desk already has someone else's family photos on it.", "words": [[24.52, 24.64, " The"], [24.64, 24.88, " emails"], [24.88, 25.28, " stop,"], [25.46, 25.54, " and"], [25.54, 25.64, " your"], [25.64, 25.82, " old"], [25.82, 26.14, " desk"], [26.14, 26.46, " already"], [26.46, 26.7, " has"], [26.7, 26.96, " someone"], [26.96, 27.3, " else's"], [27.3, 27.54, " family"], [27.54, 27.84, " photos"], [27.84, 28.18, " on"], [28.18, 28.32, " it."]]}, {"start": 28.32, "end": 32.9, "text": " Every Friday, your boss pops his head in with a big smile to ask how you're enjoying your new role.", "words": [[28.32, 28.74, " Every"], [28.74, 29.1, " Friday,"], [29.34, 29.44, " your"], [29.44, 29.66, " boss"], [29.66, 29.92, " pops"], [29.92, 30.16, " his"], [30.16, 30.28, " head"], [30.28, 30.44, " in"], [30.44, 30.56, " with"], [30.56, 30.72, " a"], [30.72, 30.92, " big"], [30.92, 31.28, " smile"], [31.28, 31.48, " to"], [31.48, 31.7, " ask"], [31.7, 31.86, " how"], [31.86, 32.0, " you're"], [32.0, 32.28, " enjoying"], [32.28, 32.48, " your"], [32.48, 32.66, " new"], [32.66, 32.9, " role."]]}, {"start": 33.24, "end": 35.96, "text": " Still, the guy in the corner has been doing this for three years,", "words": [[33.24, 33.42, " Still,"], [33.7, 33.78, " the"], [33.78, 33.9, " guy"], [33.9, 34.04, " in"], [34.04, 34.12, " the"], [34.12, 34.36, " corner"], [34.36, 34.56, " has"], [34.56, 34.7, " been"], [34.7, 34.9, " doing"], [34.9, 35.06, " this"], [35.06, 35.24, " for"], [35.24, 35.58, " three"], [35.58, 35.96, " years,"]]}, {"start": 36.18, "end": 37.92, "text": " and looks happier than anyone in the building.", "words": [[36.18, 36.26, " and"], [36.26, 36.42, " looks"], [36.42, 36.76, " happier"], [36.76, 36.98, " than"], [36.98, 37.32, " anyone"], [37.32, 37.58, " in"], [37.58, 37.68, " the"], [37.68, 37.92, " building."]]}, {"start": 38.16, "end": 42.16, "text": " So if they want to pay you to do nothing, fine, you kick your feet up right next to him.", "words": [[38.16, 38.44, " So"], [38.44, 38.64, " if"], [38.64, 38.8, " they"], [38.8, 38.94, " want"], [38.94, 39.04, " to"], [39.04, 39.2, " pay"], [39.2, 39.34, " you"], [39.34, 39.44, " to"], [39.44, 39.56, " do"], [39.56, 39.78, " nothing,"], [40.08, 40.32, " fine,"], [40.56, 40.7, " you"], [40.7, 40.86, " kick"], [40.86, 41.04, " your"], [41.04, 41.2, " feet"], [41.2, 41.4, " up"], [41.4, 41.62, " right"], [41.62, 41.88, " next"], [41.88, 42.06, " to"], [42.06, 42.16, " him."]]}, {"start": 42.34, "end": 44.86, "text": " Then, one Monday, you walk in, and he's gone.", "words": [[42.34, 42.58, " Then,"], [42.74, 42.96, " one"], [42.96, 43.26, " Monday,"], [43.52, 43.66, " you"], [43.66, 43.88, " walk"], [43.88, 44.14, " in,"], [44.32, 44.44, " and"], [44.44, 44.64, " he's"], [44.64, 44.86, " gone."]]}, {"start": 45.1, "end": 48.98, "text": " His chair is pushed in, his desk is cleared, and nobody will tell you where he went.", "words": [[45.1, 45.24, " His"], [45.24, 45.48, " chair"], [45.48, 45.68, " is"], [45.68, 45.9, " pushed"], [45.9, 46.18, " in,"], [46.34, 46.5, " his"], [46.5, 46.76, " desk"], [46.76, 46.94, " is"], [46.94, 47.22, " cleared,"], [47.46, 47.64, " and"], [47.64, 47.92, " nobody"], [47.92, 48.2, " will"], [48.2, 48.36, " tell"], [48.36, 48.52, " you"], [48.52, 48.66, " where"], [48.66, 48.76, " he"], [48.76, 48.98, " went."]]}, {"start": 49.2, "end": 52.66, "text": " You see, Japanese law makes it almost impossible to fire someone,", "words": [[49.2, 49.28, " You"], [49.28, 49.46, " see,"], [50.1, 50.1, " Japanese"], [50.1, 50.4, " law"], [50.4, 50.62, " makes"], [50.62, 50.78, " it"], [50.78, 51.08, " almost"], [51.08, 51.72, " impossible"], [51.72, 52.02, " to"], [52.02, 52.24, " fire"], [52.24, 52.66, " someone,"]]}, {"start": 52.72, "end": 54.74, "text": " but there's no law against making them miserable.", "words": [[52.72, 52.9, " but"], [52.9, 53.1, " there's"], [53.1, 53.28, " no"], [53.28, 53.6, " law"], [53.6, 53.84, " against"], [53.84, 54.1, " making"], [54.1, 54.34, " them"], [54.34, 54.74, " miserable."]]}, {"start": 54.74, "end": 57.28, "text": " So they take away your work and your friends,", "words": [[54.74, 55.28, " So"], [55.28, 55.58, " they"], [55.58, 55.82, " take"], [55.82, 56.02, " away"], [56.02, 56.18, " your"], [56.18, 56.46, " work"], [56.46, 56.82, " and"], [56.82, 56.98, " your"], [56.98, 57.28, " friends,"]]}, {"start": 57.48, "end": 60.18, "text": " and just wait, because nobody can do nothing forever.", "words": [[57.48, 57.68, " and"], [57.68, 57.86, " just"], [57.86, 58.2, " wait,"], [58.34, 58.56, " because"], [58.56, 58.9, " nobody"], [58.9, 59.24, " can"], [59.24, 59.4, " do"], [59.4, 59.76, " nothing"], [59.76, 60.18, " forever."]]}]