[{"start": 0.0, "end": 1.7, "text": " He poured cooking oil into the sea.", "words": [[0.0, 0.16, " He"], [0.16, 0.4, " poured"], [0.4, 0.8, " cooking"], [0.8, 1.02, " oil"], [1.02, 1.26, " into"], [1.26, 1.44, " the"], [1.44, 1.7, " sea."]]}, {"start": 1.88, "end": 5.26, "text": " With a pirate ship so close behind them, he could hear the pirates laughing.", "words": [[1.88, 1.96, " With"], [1.96, 2.1, " a"], [2.1, 2.4, " pirate"], [2.4, 2.64, " ship"], [2.64, 2.98, " so"], [2.98, 3.28, " close"], [3.28, 3.64, " behind"], [3.64, 3.84, " them,"], [3.92, 4.0, " he"], [4.0, 4.12, " could"], [4.12, 4.34, " hear"], [4.34, 4.5, " the"], [4.5, 4.8, " pirates"], [4.8, 5.26, " laughing."]]}, {"start": 5.58, "end": 7.38, "text": " His captain grabs him by the collar and goes,", "words": [[5.58, 5.68, " His"], [5.68, 5.96, " captain"], [5.96, 6.32, " grabs"], [6.32, 6.5, " him"], [6.5, 6.6, " by"], [6.6, 6.76, " the"], [6.76, 6.98, " collar"], [6.98, 7.18, " and"], [7.18, 7.38, " goes,"]]}, {"start": 7.64, "end": 9.7, "text": " We're about to get boarded, and you're making soup?", "words": [[7.64, 7.76, " We're"], [7.76, 7.92, " about"], [7.92, 8.06, " to"], [8.06, 8.22, " get"], [8.22, 8.52, " boarded,"], [8.76, 8.88, " and"], [8.88, 9.04, " you're"], [9.04, 9.26, " making"], [9.26, 9.7, " soup?"]]}, {"start": 9.9, "end": 10.94, "text": " But he doesn't even look up.", "words": [[9.9, 10.02, " But"], [10.02, 10.12, " he"], [10.12, 10.38, " doesn't"], [10.38, 10.56, " even"], [10.56, 10.72, " look"], [10.72, 10.94, " up."]]}, {"start": 11.14, "end": 12.58, "text": " He just points at the black clouds.", "words": [[11.14, 11.22, " He"], [11.22, 11.38, " just"], [11.38, 11.7, " points"], [11.7, 11.88, " at"], [11.88, 11.98, " the"], [11.98, 12.2, " black"], [12.2, 12.58, " clouds."]]}, {"start": 13.14, "end": 13.98, "text": " Steer into the storm.", "words": [[13.14, 13.26, " Steer"], [13.26, 13.44, " into"], [13.44, 13.62, " the"], [13.62, 13.98, " storm."]]}, {"start": 14.16, "end": 16.32, "text": " The captain yells that they'll never survive it.", "words": [[14.16, 14.26, " The"], [14.26, 14.5, " captain"], [14.5, 14.84, " yells"], [14.84, 15.08, " that"], [15.08, 15.36, " they'll"], [15.36, 15.62, " never"], [15.62, 16.04, " survive"], [16.04, 16.32, " it."]]}, {"start": 16.4, "end": 18.44, "text": " And all he gets back is, trust the oil.", "words": [[16.4, 16.46, " And"], [16.46, 16.58, " all"], [16.58, 16.7, " he"], [16.7, 16.86, " gets"], [16.86, 17.18, " back"], [17.18, 17.48, " is,"], [17.78, 17.88, " trust"], [17.88, 18.14, " the"], [18.14, 18.44, " oil."]]}, {"start": 18.62, "end": 20.86, "text": " But then, a grappling hook clangs off the railing.", "words": [[18.62, 18.72, " But"], [18.72, 18.98, " then,"], [19.1, 19.18, " a"], [19.18, 19.58, " grappling"], [19.58, 19.86, " hook"], [19.86, 20.24, " clangs"], [20.24, 20.46, " off"], [20.46, 20.62, " the"], [20.62, 20.86, " railing."]]}, {"start": 21.04, "end": 23.96, "text": " So the captain turns the wheel, and the pirates couldn't be happier.", "words": [[21.04, 21.16, " So"], [21.16, 21.28, " the"], [21.28, 21.52, " captain"], [21.52, 21.86, " turns"], [21.86, 22.06, " the"], [22.06, 22.3, " wheel,"], [22.42, 22.5, " and"], [22.5, 22.62, " the"], [22.62, 22.96, " pirates"], [22.96, 23.4, " couldn't"], [23.4, 23.58, " be"], [23.58, 23.96, " happier."]]}, {"start": 24.14, "end": 26.58, "text": " Why waste a cannonball when the storm will do it for free?", "words": [[24.14, 24.3, " Why"], [24.3, 24.54, " waste"], [24.54, 24.68, " a"], [24.68, 25.18, " cannonball"], [25.18, 25.36, " when"], [25.36, 25.48, " the"], [25.48, 25.76, " storm"], [25.76, 25.9, " will"], [25.9, 26.02, " do"], [26.02, 26.14, " it"], [26.14, 26.3, " for"], [26.3, 26.58, " free?"]]}, {"start": 26.84, "end": 29.14, "text": " Deeper in, the waves get taller than the mast.", "words": [[26.84, 27.1, " Deeper"], [27.1, 27.38, " in,"], [27.54, 27.64, " the"], [27.64, 27.92, " waves"], [27.92, 28.12, " get"], [28.12, 28.48, " taller"], [28.48, 28.74, " than"], [28.74, 28.88, " the"], [28.88, 29.14, " mast."]]}, {"start": 29.14, "end": 32.0, "text": " And the crew is tying themselves to anything bolted down.", "words": [[29.14, 29.44, " And"], [29.44, 29.54, " the"], [29.54, 29.76, " crew"], [29.76, 29.92, " is"], [29.92, 30.22, " tying"], [30.22, 30.6, " themselves"], [30.6, 30.84, " to"], [30.84, 31.28, " anything"], [31.28, 31.56, " bolted"], [31.56, 32.0, " down."]]}, {"start": 32.16, "end": 34.38, "text": " But he's still pouring, a little at a time.", "words": [[32.16, 32.24, " But"], [32.24, 32.62, " he's"], [32.62, 32.88, " still"], [32.88, 33.3, " pouring,"], [33.5, 33.66, " a"], [33.66, 33.8, " little"], [33.8, 33.94, " at"], [33.94, 34.08, " a"], [34.08, 34.38, " time."]]}, {"start": 34.54, "end": 36.4, "text": " Always on the side the wind is coming from.", "words": [[34.54, 34.8, " Always"], [34.8, 35.0, " on"], [35.0, 35.14, " the"], [35.14, 35.38, " side"], [35.38, 35.58, " the"], [35.58, 35.74, " wind"], [35.74, 35.9, " is"], [35.9, 36.14, " coming"], [36.14, 36.4, " from."]]}, {"start": 36.64, "end": 38.32, "text": " Then the pirates swing into board.", "words": [[36.64, 36.82, " Then"], [36.82, 37.06, " the"], [37.06, 37.36, " pirates"], [37.36, 37.74, " swing"], [37.74, 38.04, " into"], [38.04, 38.32, " board."]]}, {"start": 38.52, "end": 42.66, "text": " And up ahead, a wave big enough to swallow both ships rises out of the dark.", "words": [[38.52, 38.62, " And"], [38.62, 38.72, " up"], [38.72, 39.06, " ahead,"], [39.24, 39.32, " a"], [39.32, 39.6, " wave"], [39.6, 39.94, " big"], [39.94, 40.16, " enough"], [40.16, 40.34, " to"], [40.34, 40.68, " swallow"], [40.68, 41.02, " both"], [41.02, 41.44, " ships"], [41.44, 41.84, " rises"], [41.84, 42.16, " out"], [42.16, 42.28, " of"], [42.28, 42.38, " the"], [42.38, 42.66, " dark."]]}, {"start": 42.88, "end": 45.56, "text": " You see, sailors really carried oil just for this.", "words": [[42.88, 42.94, " You"], [42.94, 43.16, " see,"], [43.6, 43.6, " sailors"], [43.6, 44.06, " really"], [44.06, 44.42, " carried"], [44.42, 44.72, " oil"], [44.72, 45.08, " just"], [45.08, 45.3, " for"], [45.3, 45.56, " this."]]}, {"start": 45.76, "end": 47.02, "text": " They called it storm oil.", "words": [[45.76, 45.86, " They"], [45.86, 46.06, " called"], [46.06, 46.34, " it"], [46.34, 46.7, " storm"], [46.7, 47.02, " oil."]]}, {"start": 47.24, "end": 48.48, "text": " Ever blown on a bowl of soup?", "words": [[47.24, 47.38, " Ever"], [47.38, 47.66, " blown"], [47.66, 47.86, " on"], [47.86, 47.96, " a"], [47.96, 48.1, " bowl"], [48.1, 48.26, " of"], [48.26, 48.48, " soup?"]]}, {"start": 48.64, "end": 51.92, "text": " The broth ripples, but the oily spots stay perfectly smooth.", "words": [[48.64, 48.76, " The"], [48.76, 49.02, " broth"], [49.02, 49.44, " ripples,"], [49.74, 49.86, " but"], [49.86, 50.0, " the"], [50.0, 50.32, " oily"], [50.32, 50.64, " spots"], [50.64, 50.96, " stay"], [50.96, 51.54, " perfectly"], [51.54, 51.92, " smooth."]]}, {"start": 52.08, "end": 53.48, "text": " Because your breath can't grab them.", "words": [[52.08, 52.3, " Because"], [52.3, 52.46, " your"], [52.46, 52.7, " breath"], [52.7, 53.06, " can't"], [53.06, 53.24, " grab"], [53.24, 53.48, " them."]]}, {"start": 53.54, "end": 55.92, "text": " And a wave can't crash if the wind can't grab it.", "words": [[53.54, 53.64, " And"], [53.64, 53.76, " a"], [53.76, 54.0, " wave"], [54.0, 54.5, " can't"], [54.5, 54.66, " crash"], [54.66, 54.88, " if"], [54.88, 55.02, " the"], [55.02, 55.22, " wind"], [55.22, 55.56, " can't"], [55.56, 55.72, " grab"], [55.72, 55.92, " it."]]}, {"start": 55.98, "end": 58.16, "text": " So when the wave reaches their oily patch of sea,", "words": [[55.98, 56.1, " So"], [56.1, 56.22, " when"], [56.22, 56.34, " the"], [56.34, 56.58, " wave"], [56.58, 56.9, " reaches"], [56.9, 57.12, " their"], [57.12, 57.44, " oily"], [57.44, 57.7, " patch"], [57.7, 57.92, " of"], [57.92, 58.16, " sea,"]]}, {"start": 58.16, "end": 60.24, "text": " it just lifts the ship and sets it down.", "words": [[58.16, 58.38, " it"], [58.38, 58.52, " just"], [58.52, 58.88, " lifts"], [58.88, 59.1, " the"], [59.1, 59.3, " ship"], [59.3, 59.58, " and"], [59.58, 59.8, " sets"], [59.8, 59.98, " it"], [59.98, 60.24, " down."]]}, {"start": 60.48, "end": 64.38, "text": " And 50 yards behind, it curls over and drops straight onto the pirate's deck.", "words": [[60.48, 60.5, " And"], [60.5, 60.76, " 50"], [60.76, 60.96, " yards"], [60.96, 61.4, " behind,"], [61.6, 61.68, " it"], [61.68, 62.02, " curls"], [62.02, 62.34, " over"], [62.34, 62.6, " and"], [62.6, 62.82, " drops"], [62.82, 63.3, " straight"], [63.3, 63.58, " onto"], [63.58, 63.78, " the"], [63.78, 64.2, " pirate's"], [64.2, 64.38, " deck."]]}]