 47.52, " quietly."]]}, {"start": 47.8, "end": 51.74, "text": " At 20, he's pacing, and by the time they open the door, he's trying to rip the bench", "words": [[47.8, 47.94, " At"], [47.94, 48.28, " 20,"], [48.46, 48.64, " he's"], [48.64, 48.96, " pacing,"], [49.16, 49.26, " and"], [49.26, 49.36, " by"], [49.36, 49.5, " the"], [49.5, 49.68, " time"], [49.68, 49.82, " they"], [49.82, 49.98, " open"], [49.98, 50.14, " the"], [50.14, 50.34, " door,"], [50.52, 50.72, " he's"], [50.72, 50.88, " trying"], [50.88, 51.06, " to"], [51.06, 51.24, " rip"], [51.24, 51.42, " the"], [51.42, 51.74, " bench"]]}, {"start": 51.74, "end": 52.46, "text": " out of the floor.", "words": [[51.74, 51.92, " out"], [51.92, 52.04, " of"], [52.04, 52.14, " the"], [52.14, 52.46, " floor."]]}, {"start": 52.68, "end": 57.4, "text": " You see, the scientist swore this pink drained the fight out of anyone in 15 minutes, so", "words": [[52.68, 52.76, " You"], [52.76, 52.96, " see,"], [53.08, 53.24, " the"], [53.24, 53.56, " scientist"], [53.56, 54.1, " swore"], [54.1, 54.36, " this"], [54.36, 54.68, " pink"], [54.68, 55.08, " drained"], [55.08, 55.26, " the"], [55.26, 55.48, " fight"], [55.48, 55.64, " out"], [55.64, 55.78, " of"], [55.78, 56.12, " anyone"], [56.12, 56.38, " in"], [56.38, 56.76, " 15"], [56.76, 57.06, " minutes,"], [57.1, 57.4, " so"]]}, {"start": 57.4, "end": 59.72, "text": " jails used it to calm their most violent prisoners.", "words": [[57.4, 57.68, " jails"], [57.68, 57.98, " used"], [57.98, 58.14, " it"], [58.14, 58.26, " to"], [58.26, 58.48, " calm"], [58.48, 58.64, " their"], [58.64, 58.82, " most"], [58.82, 59.26, " violent"], [59.26, 59.72, " prisoners."]]}, {"start": 60.12, "end": 62.14, "text": " But it only works for 15 minutes.", "words": [[60.12, 60.16, " But"], [60.16, 60.42, " it"], [60.42, 60.74, " only"], [60.74, 61.08, " works"], [61.08, 61.34, " for"], [61.34, 61.8, " 15"], [61.8, 62.14, " minutes."]]}, {"start": 62.38, "end": 64.9, "text": " Leave someone in any longer, and it does the exact opposite.", "words": [[62.38, 62.5, " Leave"], [62.5, 62.76, " someone"], [62.76, 62.94, " in"], [62.94, 63.1, " any"], [63.1, 63.5, " longer,"], [63.66, 63.74, " and"], [63.74, 63.86, " it"], [63.86, 64.0, " does"], [64.0, 64.18, " the"], [64.18, 64.52, " exact"], [64.52, 64.9, " opposite."]]}]