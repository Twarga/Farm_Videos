, " decoration."]]}, {"start": 92.3, "end": 95.6, "text": " As soon as everyone tasted it, the head chef became even more angry.", "words": [[92.3, 92.46, " As"], [92.46, 92.64, " soon"], [92.64, 92.8, " as"], [92.8, 93.1, " everyone"], [93.1, 93.38, " tasted"], [93.38, 93.66, " it,"], [93.9, 93.9, " the"], [93.9, 94.04, " head"], [94.04, 94.24, " chef"], [94.24, 94.58, " became"], [94.58, 94.96, " even"], [94.96, 95.24, " more"], [95.24, 95.6, " angry."]]}, {"start": 95.84, "end": 99.4, "text": " Turns out he had been fired on the spot and the man was instantly hired to be the", "words": [[95.84, 95.96, " Turns"], [95.96, 96.24, " out"], [96.24, 96.46, " he"], [96.46, 96.58, " had"], [96.58, 96.72, " been"], [96.72, 97.02, " fired"], [97.02, 97.22, " on"], [97.22, 97.32, " the"], [97.32, 97.6, " spot"], [97.6, 97.84, " and"], [97.84, 97.94, " the"], [97.94, 98.12, " man"], [98.12, 98.28, " was"], [98.28, 98.64, " instantly"], [98.64, 99.02, " hired"], [99.02, 99.16, " to"], [99.16, 99.28, " be"], [99.28, 99.4, " the"]]}, {"start": 99.4, "end": 100.08, "text": " new head chef.", "words": [[99.4, 99.6, " new"], [99.6, 99.78, " head"], [99.78, 100.08, " chef."]]}]