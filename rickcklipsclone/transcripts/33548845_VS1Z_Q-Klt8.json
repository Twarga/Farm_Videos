[{"start": 0.0, "end": 3.1, "text": " He put a bronze ball in a dragon's mouth and told the Emperor,", "words": [[0.0, 0.18, " He"], [0.18, 0.3, " put"], [0.3, 0.44, " a"], [0.44, 0.74, " bronze"], [0.74, 1.08, " ball"], [1.08, 1.26, " in"], [1.26, 1.38, " a"], [1.38, 1.86, " dragon's"], [1.86, 2.08, " mouth"], [2.08, 2.42, " and"], [2.42, 2.6, " told"], [2.6, 2.78, " the"], [2.78, 3.1, " Emperor,"]]}, {"start": 3.36, "end": 4.94, "text": " if this ever falls out, run.", "words": [[3.36, 3.36, " if"], [3.36, 3.56, " this"], [3.56, 3.9, " ever"], [3.9, 4.16, " falls"], [4.16, 4.54, " out,"], [4.82, 4.94, " run."]]}, {"start": 5.26, "end": 7.04, "text": " The whole court burst out laughing.", "words": [[5.26, 5.36, " The"], [5.36, 5.66, " whole"], [5.66, 6.02, " court"], [6.02, 6.36, " burst"], [6.36, 6.64, " out"], [6.64, 7.04, " laughing."]]}, {"start": 7.26, "end": 10.76, "text": " You see, there were eight dragons coiled around a giant bronze jar,", "words": [[7.26, 7.32, " You"], [7.32, 7.5, " see,"], [7.72, 7.82, " there"], [7.82, 8.0, " were"], [8.0, 8.28, " eight"], [8.28, 8.78, " dragons"], [8.78, 9.22, " coiled"], [9.22, 9.44, " around"], [9.44, 9.7, " a"], [9.7, 10.02, " giant"], [10.02, 10.36, " bronze"], [10.36, 10.76, " jar,"]]}, {"start": 10.98, "end": 13.22, "text": " each holding a ball over a frog's open mouth.", "words": [[10.98, 11.1, " each"], [11.1, 11.4, " holding"], [11.4, 11.56, " a"], [11.56, 11.8, " ball"], [11.8, 12.1, " over"], [12.1, 12.36, " a"], [12.36, 12.7, " frog's"], [12.7, 12.92, " open"], [12.92, 13.22, " mouth."]]}, {"start": 13.42, "end": 15.52, "text": " But the Emperor had the biggest army in the world,", "words": [[13.42, 13.48, " But"], [13.48, 13.62, " the"], [13.62, 13.92, " Emperor"], [13.92, 14.16, " had"], [14.16, 14.34, " the"], [14.34, 14.68, " biggest"], [14.68, 14.94, " army"], [14.94, 15.12, " in"], [15.12, 15.22, " the"], [15.22, 15.52, " world,"]]}, {"start": 15.72, "end": 17.48, "text": " and he wasn't about to run from a jar.", "words": [[15.72, 15.86, " and"], [15.86, 16.0, " he"], [16.0, 16.28, " wasn't"], [16.28, 16.52, " about"], [16.52, 16.72, " to"], [16.72, 16.9, " run"], [16.9, 17.06, " from"], [17.06, 17.22, " a"], [17.22, 17.48, " jar."]]}, {"start": 17.8, "end": 20.14, "text": " Weeks later, a ball fell, but nothing happened.", "words": [[17.8, 17.92, " Weeks"], [17.92, 18.3, " later,"], [18.44, 18.62, " a"], [18.62, 18.84, " ball"], [18.84, 19.1, " fell,"], [19.32, 19.42, " but"], [19.42, 19.76, " nothing"], [19.76, 20.14, " happened."]]}, {"start": 20.3, "end": 22.04, "text": " Not even a ripple in the Emperor's wine.", "words": [[20.3, 20.48, " Not"], [20.48, 20.66, " even"], [20.66, 20.84, " a"], [20.84, 21.08, " ripple"], [21.08, 21.3, " in"], [21.3, 21.4, " the"], [21.4, 21.82, " Emperor's"], [21.82, 22.04, " wine."]]}, {"start": 22.34, "end": 23.86, "text": " Now they laughed even harder.", "words": [[22.34, 22.58, " Now"], [22.58, 22.78, " they"], [22.78, 23.06, " laughed"], [23.06, 23.46, " even"], [23.46, 23.86, " harder."]]}, {"start": 24.14, "end": 26.62, "text": " The Emperor called it the world's most expensive toy", "words": [[24.14, 24.26, " The"], [24.26, 24.52, " Emperor"], [24.52, 24.82, " called"], [24.82, 25.0, " it"], [25.0, 25.08, " the"], [25.08, 25.46, " world's"], [25.46, 25.64, " most"], [25.64, 26.18, " expensive"], [26.18, 26.62, " toy"]]}, {"start": 26.62, "end": 29.26, "text": " and threw the inventor out of the city, jar and all.", "words": [[26.62, 26.92, " and"], [26.92, 27.2, " threw"], [27.2, 27.36, " the"], [27.36, 27.6, " inventor"], [27.6, 27.94, " out"], [27.94, 28.08, " of"], [28.08, 28.22, " the"], [28.22, 28.46, " city,"], [28.88, 28.9, " jar"], [28.9, 29.06, " and"], [29.06, 29.26, " all."]]}, {"start": 29.26, "end": 31.6, "text": " So he dragged it up a hill outside the walls", "words": [[29.26, 29.6, " So"], [29.6, 29.9, " he"], [29.9, 30.22, " dragged"], [30.22, 30.36, " it"], [30.36, 30.46, " up"], [30.46, 30.58, " a"], [30.58, 30.72, " hill"], [30.72, 31.1, " outside"], [31.1, 31.3, " the"], [31.3, 31.6, " walls"]]}, {"start": 31.6, "end": 32.64, "text": " and lived there alone.", "words": [[31.6, 31.9, " and"], [31.9, 32.1, " lived"], [32.1, 32.3, " there"], [32.3, 32.64, " alone."]]}, {"start": 33.06, "end": 34.6, "text": " Then, one night, a ball dropped.", "words": [[33.06, 33.06, " Then,"], [33.36, 33.5, " one"], [33.5, 33.78, " night,"], [33.96, 34.08, " a"], [34.08, 34.28, " ball"], [34.28, 34.6, " dropped."]]}, {"start": 34.82, "end": 36.82, "text": " Then another, then all ate at once.", "words": [[34.82, 34.96, " Then"], [34.96, 35.2, " another,"], [35.46, 35.64, " then"], [35.64, 36.0, " all"], [36.0, 36.32, " ate"], [36.32, 36.5, " at"], [36.5, 36.82, " once."]]}, {"start": 37.06, "end": 39.42, "text": " He ran to the city gates, screaming for everyone", "words": [[37.06, 37.18, " He"], [37.18, 37.42, " ran"], [37.42, 37.6, " to"], [37.6, 37.72, " the"], [37.72, 37.88, " city"], [37.88, 38.2, " gates,"], [38.46, 38.76, " screaming"], [38.76, 39.08, " for"], [39.08, 39.42, " everyone"]]}, {"start": 39.42, "end": 40.2, "text": " to get out.", "words": [[39.42, 39.7, " to"], [39.7, 39.88, " get"], [39.88, 40.2, " out."]]}, {"start": 40.46, "end": 41.66, "text": " Hey, it's the toy guy.", "words": [[40.46, 40.64, " Hey,"], [40.8, 40.98, " it's"], [40.98, 41.14, " the"], [41.14, 41.38, " toy"], [41.38, 41.66, " guy."]]}, {"start": 41.88, "end": 43.26, "text": " Did your frogs get hungry again?", "words": [[41.88, 41.96, " Did"], [41.96, 42.12, " your"], [42.12, 42.4, " frogs"], [42.4, 42.62, " get"], [42.62, 42.94, " hungry"], [42.94, 43.26, " again?"]]}, {"start": 43.44, "end": 45.64, "text": " The guards laughed him all the way back up the hill.", "words": [[43.44, 43.58, " The"], [43.58, 43.78, " guards"], [43.78, 44.14, " laughed"], [44.14, 44.34, " him"], [44.34, 44.64, " all"], [44.64, 44.78, " the"], [44.78, 44.94, " way"], [44.94, 45.18, " back"], [45.18, 45.32, " up"], [45.32, 45.46, " the"], [45.46, 45.64, " hill."]]}, {"start": 45.82, "end": 48.28, "text": " The next morning, the palace was a pile of rubble.", "words": [[45.82, 45.94, " The"], [45.94, 46.12, " next"], [46.12, 46.44, " morning,"], [46.66, 46.76, " the"], [46.76, 47.1, " palace"], [47.1, 47.34, " was"], [47.34, 47.6, " a"], [47.6, 47.82, " pile"], [47.82, 48.02, " of"], [48.02, 48.28, " rubble."]]}, {"start": 48.56, "end": 50.44, "text": " Inside the jar hung a heavy pendulum", "words": [[48.56, 48.86, " Inside"], [48.86, 49.1, " the"], [49.1, 49.34, " jar"], [49.34, 49.54, " hung"], [49.54, 49.7, " a"], [49.7, 49.98, " heavy"], [49.98, 50.44, " pendulum"]]}, {"start": 50.44, "end": 52.24, "text": " with a rod pointing at each dragon.", "words": [[50.44, 50.68, " with"], [50.68, 50.86, " a"], [50.86, 51.1, " rod"], [51.1, 51.42, " pointing"], [51.42, 51.64, " at"], [51.64, 51.84, " each"], [51.84, 52.24, " dragon."]]}, {"start": 52.42, "end": 55.06, "text": " The slightest nudge and the pendulum swung into a rod.", "words": [[52.42, 52.56, " The"], [52.56, 52.88, " slightest"], [52.88, 53.26, " nudge"], [53.26, 53.56, " and"], [53.56, 53.68, " the"], [53.68, 54.06, " pendulum"], [54.06, 54.42, " swung"], [54.42, 54.64, " into"], [54.64, 54.82, " a"], [54.82, 55.06, " rod."]]}, {"start": 55.2, "end": 57.94, "text": " The rod snapped the dragon's jaw open and the ball dropped.", "words": [[55.2, 55.3, " The"], [55.3, 55.46, " rod"], [55.46, 55.88, " snapped"], [55.88, 56.08, " the"], [56.08, 56.46, " dragon's"], [56.46, 56.66, " jaw"], [56.66, 56.92, " open"], [56.92, 57.22, " and"], [57.22, 57.36, " the"], [57.36, 57.62, " ball"], [57.62, 57.94, " dropped."]]}, {"start": 57.94, "end": 60.14, "text": " One ball meant a nudge from far away.", "words": [[57.94, 58.48, " One"], [58.48, 58.74, " ball"], [58.74, 58.94, " meant"], [58.94, 59.08, " a"], [59.08, 59.38, " nudge"], [59.38, 59.56, " from"], [59.56, 59.82, " far"], [59.82, 60.14, " away."]]}, {"start": 60.4, "end": 62.08, "text": " All eight meant the biggest earthquake", "words": [[60.4, 60.54, " All"], [60.54, 60.84, " eight"], [60.84, 61.1, " meant"], [61.1, 61.24, " the"], [61.24, 61.6, " biggest"], [61.6, 62.08, " earthquake"]]}, {"start": 62.08, "end": 64.74, "text": " the empire had ever seen was right underneath them.", "words": [[62.08, 62.28, " the"], [62.28, 62.6, " empire"], [62.6, 62.84, " had"], [62.84, 63.18, " ever"], [63.18, 63.54, " seen"], [63.54, 63.76, " was"], [63.76, 64.12, " right"], [64.12, 64.46, " underneath"], [64.46, 64.74, " them."]]}]